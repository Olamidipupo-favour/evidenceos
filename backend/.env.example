# EvidenceOS API — environment configuration
# Copy to backend/.env and adjust as needed.
# Never commit real secrets.

# Application
APP_NAME=EvidenceOS API
APP_ENV=development

# Comma list is NOT used here: pydantic-settings parses list[str] from JSON.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# PostgreSQL (see database/README.md to start a local instance)
DATABASE_URL=postgresql+psycopg://evidenceos:evidenceos@localhost:5432/evidenceos

# --- PubMed/NCBI (E-utilities) ---
# NCBI requires a contact email. An API key (https://www.ncbi.nlm.nih.gov/account/settings/)
# raises the request rate from ~3/s to 10/s and improves reliability.
# PUBMED_EMAIL=you@example.com
# PUBMED_API_KEY=
# NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils