# EvidenceOS API — environment configuration
# Copy to backend/.env and adjust as needed.
# Never commit real secrets.

# Application
APP_NAME=EvidenceOS API
APP_ENV=development

# Comma list is NOT used here: pydantic-settings parses list[str] from JSON.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# PostgreSQL (see database/README.md to start a local instance)
DATABASE_URL=postgresql+psycopg://evidenceos:evidenceos@localhost:5432/evidenceos

# --- PubMed/NCBI (planned) ---
# PUBMED_EMAIL=you@example.com
# PUBMED_API_KEY=