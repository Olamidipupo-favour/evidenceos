{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidenceos/tools/search_literature",
  "title": "Search literature",
  "description": "Search biological and medical literature (PubMed).",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Free-text or PubMed-style clinical search query, e.g. \"metformin AND type 2 diabetes\"."
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Page of results to return (1-based)."
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 25,
      "description": "Number of results per page (1–100)."
    }
  },
  "required": ["query"],
  "additionalProperties": false
}
